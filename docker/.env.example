# DailyNews docker environment
# Copy to .env and adjust before running docker compose up

APP_ENV=production

# Web
WEB_PORT=8080

# MySQL (web app framework db)
DB_DATABASE=dailynews
DB_USERNAME=dailynews
DB_PASSWORD=dailynews
DB_ROOT_PASSWORD=rootsecret

# PostgreSQL (main data)
PGSQL_DATABASE=ittipolint_dailynews
PGSQL_USERNAME=ittipolint_dailynews
PGSQL_PASSWORD=dailynews

# n8n
N8N_HOST=n8n38-sbu.veya.co.th
N8N_WEBHOOK_URL=https://n8n38-sbu.veya.co.th/
N8N_DB_DATABASE=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n
N8N_ENCRYPTION_KEY=change-me
N8N_JWT_SECRET=change-me

# Metabase
METABASE_DB=metabase
METABASE_USER=metabase
METABASE_PASS=metabase
