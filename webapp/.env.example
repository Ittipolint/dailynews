APP_NAME=DailyNews
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=https://ittipolint-sbu.veya.co.th/dailynews
APP_LOCALE=th

LOG_CHANNEL=daily
LOG_LEVEL=debug

# ---- MariaDB / MySQL (single database) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ittipolint_dailynews
DB_USERNAME=ittipolint_dailynews
DB_PASSWORD=10203040

# ---- Cache / Session / Queue (no Redis server guaranteed on shared hosting) ----
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dailynews@ittipolint-sbu.veya.co.th
MAIL_FROM_NAME=DailyNews

# ---- n8n (background workflows) ----
N8N_URL=https://n8n38-sbu.veya.co.th
N8N_API_KEY=
N8N_FETCH_WEBHOOK=https://n8n38-sbu.veya.co.th/webhook/dailynews-fetch-now
DAILYNEWS_API_BASE_URL=https://ittipolint-sbu.veya.co.th/dailynews

# ---- API token shared with n8n workflows (X-API-Token header) ----
API_TOKEN=

# ---- Translation engine (Google Gemini LLM) ----
TRANSLATION_DRIVER=google
TRANSLATION_API_KEY=
TRANSLATION_MODEL=gemini-2.5-flash
TRANSLATION_BASE_URL=
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# ---- AI Graph RAG / LLM (multi-provider with automatic fallback) ----
# Primary provider. "google" uses the Gemini API; "openai" uses any
# OpenAI-compatible /chat/completions endpoint (Groq, OpenRouter, OpenAI,
# DeepSeek...) via LLM_BASE_URL. If the primary call fails (quota, auth,
# network), LLM_FALLBACK_* is tried automatically.
LLM_DRIVER=google
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT=90

# Secondary provider, tried when the primary fails.
LLM_FALLBACK_DRIVER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_TIMEOUT=90

# Example: use Groq as the fallback when Gemini quota is exhausted.
# LLM_FALLBACK_DRIVER=openai
# LLM_FALLBACK_MODEL=llama-3.3-70b-versatile
# LLM_FALLBACK_API_KEY=gsk_...
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1

# ---- News category classification via LLM (default: keyword-based) ----
# Set to true to classify each article with the configured LLM, falling back
# to the keyword scorer when the LLM is unavailable.
CATEGORY_CLASSIFIER_LLM_ENABLED=false

EMBEDDING_DRIVER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=

# ---- LINE Messaging API ----
LINE_CHANNEL_ID=1528339539
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LINE_WEBHOOK_URL=https://n8n38-sbu.veya.co.th/webhook/line

# ---- Initial admin user (run seeder) ----
ADMIN_NAME="DailyNews Admin"
ADMIN_EMAIL=ittipolint@gmail.com
ADMIN_PASSWORD=

# ---- Web-based setup (installer) token ----
SETUP_TOKEN=

# ---- Database encryption key for credentials at rest ----
CREDENTIAL_ENCRYPTION_KEY=
