APP_NAME=DailyNews
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Bangkok
APP_URL=https://ittipolint-sbu.veya.co.th/dailynews
APP_LOCALE=th

LOG_CHANNEL=daily
LOG_LEVEL=debug

# ---- MySQL (Web Application framework DB) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dailynews
DB_USERNAME=dailynews
DB_PASSWORD=

# ---- PostgreSQL (Main data: news, members, translations, delivery) ----
PGSQL_CONNECTION=pgsql
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DATABASE=ittipolint_dailynews
PGSQL_USERNAME=ittipolint_dailynews
PGSQL_PASSWORD=

# ---- Redis (cache + queue) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_CLIENT=predis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dailynews@ittipolint-sbu.veya.co.th
MAIL_FROM_NAME=DailyNews

# ---- n8n (background workflows) ----
N8N_URL=https://n8n38-sbu.veya.co.th
N8N_API_KEY=

# ---- Translation engine (Google Gemini LLM) ----
TRANSLATION_DRIVER=google
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-1.5-flash

# ---- AI Graph RAG ----
LLM_DRIVER=google
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=
EMBEDDING_DRIVER=google
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_API_KEY=

# ---- Graph Database (Neo4j) ----
NEO4J_HOST=127.0.0.1
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# ---- Vector Store (pgvector on PostgreSQL) ----
VECTOR_DRIVER=pgvector
VECTOR_DIMENSIONS=768

# ---- LINE Messaging API ----
LINE_CHANNEL_ID=1528339539
LINE_CHANNEL_SECRET=
LINE_ACCESS_TOKEN=
LINE_WEBHOOK_URL=https://n8n38-sbu.veya.co.th/webhook/line

# ---- Initial admin user (run seeder) ----
ADMIN_NAME=DailyNews Admin
ADMIN_EMAIL=ittipolint@gmail.com
ADMIN_PASSWORD=

# ---- Database encryption key for credentials at rest ----
CREDENTIAL_ENCRYPTION_KEY=
