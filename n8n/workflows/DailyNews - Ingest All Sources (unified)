    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst titleArr = Array.isArray(j.title) ? j.title : [];\nconst titleTextArr = Array.isArray(j.titleText) ? j.titleText : [];\nconst linkArr = Array.isArray(j.link) ? j.link : [];\nconst hrefArr = Array.isArray(j.linkHref) ? j.linkHref : [];\nconst source = $('Loop Sources').item.json;\nconst base = source.url || source.feed_url || '';\nlet baseOrigin = '';\nconst m = String(base).match(/^(https?:\\/\\/[^/]+)/i);\nif (m) baseOrigin = m[1];\nconst count = Math.max(titleArr.length, linkArr.length, titleTextArr.length, hrefArr.length);\nconst items = [];\nfor (let i = 0; i < count; i++) {\n  let title = String(titleArr[i] || titleTextArr[i] || '').trim();\n  let link = String(linkArr[i] || hrefArr[i] || '').trim();\n  if (!title || !link) continue;\n  if (link.startsWith('//')) link = 'https:' + link;\n  else if (link.startsWith('/') && baseOrigin) link = baseOrigin + link;\n  else if (!/^https?:/i.test(link) && baseOrigin) link = baseOrigin + '/' + link.replace(/^\\/+/g, '');\n  if (!/^https?:\\/\\//i.test(link)) continue;\n  items.push({ title, url: link, summary: '', published_at: null });\n}\nconst seen = new Set();\nconst deduped = [];\nfor (const it of items) {\n  const k = (it.url + '|' + it.title).toLowerCase();\n  if (seen.has(k)) continue;\n  seen.add(k);\n  deduped.push(it);\n}\nreturn [{ json: { source: source.slug, items: deduped, has_items: deduped.length > 0 ? 'yes' : 'no' } }];"
      },
