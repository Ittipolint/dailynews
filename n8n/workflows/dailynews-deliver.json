                                         "genericAuthType":  "httpHeaderAuth",
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{\n  member_id: $json.schedule.member.id,\n  channel_type: $json.channel_type,\n  news_ids: $json.news_ids,\n  status: $json.status === \u0027skipped\u0027 ? \u0027success\u0027 : $json.status\n}}",
                                         "options":  {

                                                     }
                                     },
                      "id":  "http-log",
