    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst html = (raw && typeof raw === 'object' && raw.body) ? raw.body : (raw || '');\nreturn [{ json: { html: String(html), source: $('Extract Source').item.json.source } }];"
      },
      "id": "code-prep-crawl",
      "name": "Prep Crawl HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 480]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "json",
        "dataPropertyName": "html",
        "extractionValues": {
          "values": [
            {
              "key": "title",
              "cssSelector": "={{ $json.source.config.selectors.title || 'a' }}",
              "returnValue": "attribute",
              "attribute": "data-title",
              "returnArray": true
            },
            {
              "key": "titleText",
              "cssSelector": "={{ $json.source.config.selectors.title || 'a' }}",
              "returnValue": "text",
              "returnArray": true
            },
            {
              "key": "link",
              "cssSelector": "={{ $json.source.config.selectors.link || 'a' }}",
              "returnValue": "attribute",
              "attribute": "data-url",
              "returnArray": true
            },
            {
              "key": "linkHref",
              "cssSelector": "={{ $json.source.config.selectors.link || 'a' }}",
              "returnValue": "attribute",
              "attribute": "href",
              "returnArray": true
            }
          ]
        },
        "options": {}
      },
      "id": "html-extract-crawl",
      "name": "Extract Crawl Items",
      "type": "n8n-nodes-base.html",
      "typeVersion": 2,
      "position": [1200, 480]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst titleArr = Array.isArray(j.title) ? j.title : [];\nconst titleTextArr = Array.isArray(j.titleText) ? j.titleText : [];\nconst linkArr = Array.isArray(j.link) ? j.link : [];\nconst hrefArr = Array.isArray(j.linkHref) ? j.linkHref : [];\nconst source = $('Extract Source').item.json.source;\nconst base = source.url || source.feed_url || '';\nlet baseOrigin = '';\nconst m = String(base).match(/^(https?:\\/\\/[^/]+)/i);\nif (m) baseOrigin = m[1];\nconst count = Math.max(titleArr.length, linkArr.length, titleTextArr.length, hrefArr.length);\nconst items = [];\nfor (let i = 0; i < count; i++) {\n  let title = String(titleArr[i] || titleTextArr[i] || '').trim();\n  let link = String(linkArr[i] || hrefArr[i] || '').trim();\n  if (!title || !link) continue;\n  if (link.startsWith('//')) link = 'https:' + link;\n  else if (link.startsWith('/') && baseOrigin) link = baseOrigin + link;\n  else if (!/^https?:/i.test(link) && baseOrigin) link = baseOrigin + '/' + link.replace(/^\\/+/g, '');\n  if (!/^https?:\\/\\//i.test(link)) continue;\n  if (/\\s/.test(link)) continue;\n  items.push({ title, url: link, summary: '', published_at: null });\n}\nconst seen = new Set();\nconst deduped = [];\nfor (const it of items) {\n  const k = (it.url + '|' + it.title).toLowerCase();\n  if (seen.has(k)) continue;\n  seen.add(k);\n  deduped.push(it);\n}\nif (!deduped.length) return [];\n\nconst htmlNode = $('Prep Crawl HTML');\nlet rawHtml = '';\nif (htmlNode && htmlNode.item && htmlNode.item.json) {\n  rawHtml = String(htmlNode.item.json.html || '');\n}\nif (rawHtml) {\n  for (const it of deduped) {\n    const urlIdx = rawHtml.indexOf(it.url);\n    if (urlIdx === -1) continue;\n    const before = rawHtml.slice(Math.max(0, urlIdx - 5000), urlIdx);\n    const stampMatch = before.match(/data-posted-date-timestamp=\"(\\d+)\"/);\n    if (stampMatch) {\n      it.published_at = new Date(parseInt(stampMatch[1])).toISOString();\n    }\n    const after = rawHtml.slice(urlIdx, urlIdx + 3000);\n    const summMatch = after.match(/<div class=\"PagePromo-description\">[\\s\\S]*?<span[^>]*class=\"[^\"]*PagePromoContentIcons-text[^\"]*\"[^>]*>([\\s\\S]*?)<\\/span>/);\n    if (summMatch && summMatch[1]) {\n      it.summary = summMatch[1].replace(/\\s+/g, ' ').trim();\n    }\n  }\n}\n\nreturn [{ json: {\n  source: source.slug,\n  items: deduped\n} }];"
      },
      "id": "code-build-crawl",
      "name": "Build Crawl Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 480]
    },
