      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1.2,
      "position": [720, -240]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => ({\n  title: i.json.title,\n  url: i.json.link,\n  summary: i.json.summary || i.json.description || i.json.contentSnippet || i.json.content || '',\n  published_at: i.json.pubDate || i.json.isoDate || null\n}));\n\nif (items.length === 0) return [];\n\nreturn [{ json: {\n  source: $('Extract Source').item.json.source.slug,\n  items: items\n} }];"
      },
      "id": "code-build-rss",
      "name": "Build RSS Payload",
      "type": "n8n-nodes-base.code",
