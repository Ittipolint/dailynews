      "id": "http-api",
      "name": "Call API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 240]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst payload = raw.body && typeof raw.body === 'object' && !Array.isArray(raw.body) ? raw.body : raw;\n\n// AP News GraphQL (ContentPageQuery) fallback\nconst pagePromos = [];\nfunction walk(o) {\n  if (!o || typeof o !== 'object') return;\n  if (o.__typename === 'PagePromo') { pagePromos.push(o); return; }\n  for (const k of Object.keys(o)) { if (k === '__typename') continue; walk(o[k]); }\n}\nconst screen = payload.data && payload.data.Screen;\nif (screen && typeof screen === 'object') walk(screen);\n\nlet articles = [];\nif (pagePromos.length) {\n  articles = pagePromos;\n} else {\n  articles = payload.articles || payload.data || payload.results || [];\n}\n\nconst items = articles.map(a => {\n  let pub = a.publishedAt || a.published_at || null;\n  if (!pub && a.publishDateStamp) pub = new Date(a.publishDateStamp).toISOString();\n  return {\n    title: a.title,\n    url: a.url || a.link,\n    summary: a.description || a.summary || '',\n    published_at: pub\n  };\n});\n\nif (items.length === 0) return [];\n\nreturn [{ json: {\n  source: $('Extract Source').item.json.source.slug,\n  items: items\n} }];"
      },
      "id": "code-normalize-api",
      "name": "Normalize API Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 240]
