      "id": "http-push-rss",
      "name": "Push RSS to DailyNews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, -240],
      "credentials": {
        "httpHeaderAuth": {
          "id": "tjTHYNN0eR5OYkDc",
